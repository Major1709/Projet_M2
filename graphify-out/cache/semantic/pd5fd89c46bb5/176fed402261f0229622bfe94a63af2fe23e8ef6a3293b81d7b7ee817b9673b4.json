{"nodes": [{"id": "project_context_vision", "label": "Project Vision (chat assistant over Jira/Confluence/Figma)", "file_type": "concept", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Groq serves the LLM; Jira/Confluence/Figma are reached only through MCP servers; the backend orchestrates MCP calls, enforces security rules and manages human validations."}, {"id": "project_context_principes_non_negociables", "label": "Principes non n\u00e9gociables", "file_type": "rationale", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The LLM never decides permissions itself; every create/modify/delete requires explicit user confirmation with an exact preview/diff; permissions are re-checked right before execution; Jira/Confluence/Figma remain sources of truth and the RAG is only a derived index."}, {"id": "project_context_workflow_metier", "label": "Workflow m\u00e9tier principal (Jira -> Confluence -> Jira)", "file_type": "concept", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "project_context_modele_connaissances", "label": "Mod\u00e8le de connaissances envisag\u00e9 (hybrid RAG + graph)", "file_type": "concept", "source_file": "PROJECT_CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommends vector search for semantic proximity plus a business graph for relations/traceability; inferred relations keep their origin, confidence score and validation state distinct from deterministic ones."}, {"id": "project_context_architecture_technique", "label": "Architecture technique envisag\u00e9e (stack)", "file_type": "concept", "source_file": "PROJECT_CONTEXT.md", "source_l
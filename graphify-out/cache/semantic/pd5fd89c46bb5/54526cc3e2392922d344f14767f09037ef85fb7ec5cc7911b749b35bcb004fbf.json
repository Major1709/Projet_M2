{"nodes": [{"id": "claude_skills_graphify_references_query_vocab_expansion", "label": "Constrained query vocabulary expansion", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query CLI matches via case-folded substring + IDF with no stemming or cross-language matching, so a wording mismatch collapses the answer to noise; the fix is expanding the question against the graph's own extracted vocabulary before traversal, never inventing tokens."}, {"id": "claude_skills_graphify_references_query_bfs_dfs", "label": "BFS/DFS traversal modes", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BFS gives broad context (What is X connected to?); DFS traces a specific chain (How does X reach Y?)."}], "edges": [{"source": "claude_skills_graphify_references_query_vocab_expansion", "target": "claude_skills_graphify_references_query_bfs_dfs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_vocab_expansion", "target": "docs_development_logs_mcp_ro_arch_001_agent_orchestration_loop", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
# Compose et images (valeurs non sensibles uniquement)
COMPOSE_PROJECT_NAME=projet-m2
APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

FRONTEND_IMAGE=projet-m2-frontend:local
BACKEND_IMAGE=projet-m2-backend:local
PGVECTOR_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7.4-alpine

# Publication locale. En production, exposer uniquement le reverse proxy TLS.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# Le navigateur utilise le BFF Next.js ; cette URL est uniquement serveur-a-serveur.
API_INTERNAL_URL=http://api:8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL / pgvector
POSTGRES_DB=projet_m2
POSTGRES_USER=projet_m2
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_APP=app.worker.celery_app
CELERY_CONCURRENCY=2

# LLM, embeddings et limites de l'orchestrateur
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
MAX_AGENT_STEPS=12
MAX_MCP_CALLS_PER_TURN=8

# OIDC. Les valeurs .invalid ne contactent aucun fournisseur reel.
OIDC_ISSUER_URL=https://identity.example.invalid
OIDC_CLIENT_ID=projet-m2-web
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Endpoints MCP non secrets. A remplacer apres qualification des serveurs.
JIRA_MCP_URL=https://jira-mcp.example.invalid/mcp
CONFLUENCE_MCP_URL=https://confluence-mcp.example.invalid/mcp
FIGMA_MCP_URL=https://figma-mcp.example.invalid/mcp

# Kill switches : default deny pour le premier demarrage.
MCP_READ_ENABLED=false
MCP_MUTATIONS_ENABLED=false
JIRA_MCP_ENABLED=false
CONFLUENCE_MCP_ENABLED=false
FIGMA_MCP_ENABLED=false
FIGMA_WRITE_ENABLED=false

# Observabilite. Activer seulement quand un collecteur OTLP est configure.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
METRICS_ENABLED=true

# Les fichiers reels restent ignores par Git. Ne pas mettre leur contenu ici.
SECRETS_DIR=./secrets/dev


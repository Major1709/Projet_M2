# Ce fichier n'est lu que par Docker Compose, et uniquement pour les variables
# qu'il interpole explicitement. Deux filtres s'appliquent ensuite :
#   1. une variable absente de compose.yaml n'a aucun effet ;
#   2. le backend ne lit que les variables prefixees PKA_ (env_prefix pydantic),
#      les autres sont consommees par Compose, le runtime ou une bibliotheque.
# Une variable ajoutee ici sans entree correspondante dans compose.yaml est morte.

# Compose et images (valeurs non sensibles uniquement)
COMPOSE_PROJECT_NAME=projet-m2
APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

FRONTEND_IMAGE=projet-m2-frontend:local
BACKEND_IMAGE=projet-m2-backend:local
PGVECTOR_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7.4-alpine

# Publication locale. En production, exposer uniquement le reverse proxy TLS.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# Le navigateur utilise le BFF Next.js ; cette URL est uniquement serveur-a-serveur.
API_INTERNAL_URL=http://api:8000

# Origines navigateur autorisees a appeler l'API, en JSON strict. Vide n'installe
# aucun middleware CORS : le navigateur refuse alors l'appel avant de l'emettre.
# Origines exactes uniquement -- les en-tetes d'identite sont le locataire, donc
# une origine autorisee a les envoyer choisit le tenant.
PKA_FRONTEND_ORIGINS=["http://localhost:3000"]

# PostgreSQL / pgvector
POSTGRES_DB=projet_m2
POSTGRES_USER=projet_m2
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis / Celery. L'hote et le port sont fixes par Compose (redis:6379) et ne
# sont volontairement pas parametrables ici.
REDIS_DB=0
CELERY_APP=app.worker.celery_app
CELERY_CONCURRENCY=2

# LLM et embeddings.
# L'adaptateur Groq existe desormais et lit les deux variables PKA_ ci-dessous.
# Les variables EMBEDDING_* restent anticipees : aucun module d'embeddings n'est
# implemente, et sans prefixe PKA_ le backend ne les lirait pas de toute facon.
# L'URL de Groq n'est pas parametrable : elle est epinglee dans l'adaptateur, et
# validee a l'import. Une destination configurable est un levier qu'un fichier
# d'environnement modifie peut actionner, en emportant la cle API avec lui.
# qwen/qwen3.6-27b : 131 072 tokens de contexte mais seulement 16 384 tokens de
# sortie. L'adaptateur borne max_tokens a cette valeur, une demande superieure est
# ramenee au plafond plutot que tronquee en silence par le fournisseur.
# Modele en preview chez Groq : evaluation seulement, pas de garantie de
# disponibilite. A rebasculer sur un modele de production avant toute demo.
PKA_LLM_GROQ_MODEL=qwen/qwen3.6-27b
PKA_LLM_GROQ_ENABLED=false
EMBEDDING_PROVIDER=local
# Decide le 17/08/2026 : multilingual-e5-base, 768 dimensions, MIT, execute
# localement pour ne pas ouvrir une seconde destination sortante au contenu.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# OIDC. Les valeurs .invalid ne contactent aucun fournisseur reel.
# Aucun flux OAuth/OIDC n'est implemente a ce jour ; l'identite reste en mode
# en-tetes de developpement (PKA_AUTH_MODE=dev_headers, fixe par Compose).
OIDC_ISSUER_URL=https://identity.example.invalid
OIDC_CLIENT_ID=projet-m2-web
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# MCP read-only. Les endpoints et cibles sont fixes dans le backend, pas dans
# l'environnement. Tous les niveaux doivent etre actives pour autoriser une lecture.
PKA_MCP_READS_ENABLED=false
PKA_MCP_ATLASSIAN_ENABLED=false
PKA_MCP_JIRA_ENABLED=false
PKA_MCP_CONFLUENCE_ENABLED=false
PKA_MCP_FIGMA_ENABLED=false
PKA_MCP_GRANT_BACKEND=disabled

# Invariant du lot : Compose injecte toujours false en dur et le backend refuse
# true au demarrage. Volontairement non parametrable ici ; la ligne reste en
# commentaire pour documenter l'invariant sans laisser croire qu'il est reglable.
# PKA_MCP_MUTATIONS_ENABLED=false

# Liaisons non secretes. Le Compose de base ne les transmet volontairement pas :
# le backend refuse de demarrer si une liaison est presente alors que
# PKA_MCP_GRANT_BACKEND vaut disabled. Elles ne sont lues que par les surcouches
# d'activation, a decommenter dans infra/.env quand tu passes a la phase voulue.
#
# Phase 2, amorcage et decouverte des cloudId :
#   docker compose -f compose.yaml -f compose.atlassian.yaml up
# Les deux valeurs ci-dessous doivent correspondre EXACTEMENT aux en-tetes
# d'identite envoyes sur POST /api/mcp/reads, sinon toute lecture repond 503.
# PKA_MCP_ATLASSIAN_GRANT_TENANT_ID=tenant-sandbox
# PKA_MCP_ATLASSIAN_GRANT_USER_ID=user-sandbox
#
# Phase 3, une fois les cloudId obtenus par getAccessibleAtlassianResources :
#   docker compose -f compose.yaml -f compose.atlassian.yaml \
#                  -f compose.atlassian-bindings.yaml up
# Ce sont des UUID. Atlassian emet un cloudId par SITE, couvrant les deux
# produits : valeurs identiques sur un site unique, distinctes si Jira et
# Confluence vivent sur deux sites.
# PKA_MCP_ATLASSIAN_JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000
# PKA_MCP_ATLASSIAN_CONFLUENCE_CLOUD_ID=11111111-1111-1111-1111-111111111111
#
# Deux sites impliquent DEUX jetons : un jeton delegue n'en couvre qu'un seul.
# Ajouter alors une surcouche qui donne un jeton a chaque site, faute de quoi la
# liaison hebergee sur l'autre site repond 401, remonte en 502, et le diagnostic
# oriente a tort vers le reseau. Deux surcouches font ce travail :
#
#   -f compose.atlassian-oauth.yaml   recommande. Monte un document de
#       credentials par site, portant aussi le refresh_token : le backend
#       renouvelle seul, on autorise une fois et plus jamais ensuite.
#
#   -f compose.atlassian-sites.yaml   un simple fichier de jeton par site. Le
#       jeton Atlassian vit environ 8 h, donc cela impose une re-autorisation
#       manuelle a peu pres chaque jour ouvre.
#
# Aucun jeton n'apparait ici. Les jetons statiques vivent dans des secrets
# ${SECRETS_DIR}/atlassian_bearer_token ; les documents renouvelables dans
# ${SECRETS_DIR}/atlassian-credentials/, monte en lecture-ecriture parce que la
# rotation du refresh_token doit etre persistee.

# Figma, surcouche autonome :
#   docker compose -f compose.yaml -f compose.figma.yaml up -d
# Memes contraintes d'identite que pour Atlassian : ces deux valeurs doivent
# correspondre EXACTEMENT aux en-tetes envoyes sur POST /api/mcp/reads.
# PKA_MCP_FIGMA_GRANT_TENANT_ID=tenant-sandbox
# PKA_MCP_FIGMA_GRANT_USER_ID=user-sandbox
#
# Figma est lu par son API REST : son serveur MCP n'admet que les clients de son
# catalogue et repond 403 a tout enregistrement. L'API REST est en lecture seule
# par construction -- elle n'expose aucun point d'entree qui cree ou modifie un
# noeud -- et vit sur un hote public en HTTPS, donc aucun controle reseau n'a eu
# a etre relache pour l'atteindre.
#
# Le fileKey n'est pas configurable : epingle dans le registre et injecte cote
# serveur, comme les cloudId. Le nodeId reste un argument public : il ne designe
# qu'un noeud a l'interieur du fichier epingle.
#
# Le jeton personnel vit dans ${SECRETS_DIR}/figma_personal_access_token, monte
# en lecture seule : il ne tourne pas, il n'y a rien a reecrire.

# Observabilite. Activer seulement quand un collecteur OTLP est configure.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
METRICS_ENABLED=true

# Les fichiers reels restent ignores par Git. Ne pas mettre leur contenu ici.
SECRETS_DIR=./secrets/dev

# --- Connexion Atlassian des utilisateurs (compose.auth-atlassian.yaml) ---
# Le client id n'est pas un secret : il voyage en clair dans l'URL d'autorisation
# que le navigateur affiche. Le secret client, lui, ne figure jamais ici -- il
# vit dans ${SECRETS_DIR}/atlassian_oauth_client_secret.
PKA_ATLASSIAN_OAUTH_CLIENT_ID=remplacer-par-le-client-id-de-la-console
# Chaine exacte enregistree dans la console developpeur Atlassian.
PKA_ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/atlassian/callback
# Ou atterrit le navigateur une fois connecte. Un chemin, jamais une URL
# complete, et jamais une valeur venue de l'appelant.
PKA_ATLASSIAN_OAUTH_POST_LOGIN_PATH=/health/live
# Vide tant qu'un seul site est consenti.
PKA_ATLASSIAN_EXPECTED_CLOUD_ID=

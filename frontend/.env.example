# Copy to .env.local. The three values go together: with any of them missing the
# screen falls back to the demo adapter and performs no network call.
#
# The backend must also declare this front end's origin, otherwise the browser
# refuses the request before sending it:
#   PKA_FRONTEND_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_ASSISTANT_API_URL=http://localhost:8000

# Identity, in clear, chosen by the caller. This is the backend's dev_headers mode,
# which its own settings forbid in production -- so this file describes a developer
# machine and nothing else.
NEXT_PUBLIC_ASSISTANT_TENANT_ID=tenant-dev
NEXT_PUBLIC_ASSISTANT_USER_ID=dev-user
